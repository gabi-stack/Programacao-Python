    '2 - Duplo': 150.00,
    '3 - Luxo': 200.00
}

print()
print('CADASTRO DE CLIENTES: ')
print()
cad_cli_1 = {
    'nome_idade': [input('1° cliente - Nome: '), int(input('1° cliente - Idade: '))],
