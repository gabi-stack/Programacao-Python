# 6. Verifique se um número é positivo e maior que 10

n4 = int(input('Digite um número: '))

if n4 > 10:
    print('Este número é positivo e maior que 10.')
elif n4 > 0 and n4 <= 10:
    print('Este número é positivo, mas não é maior que 10.')
else:
    print('Este número é negativo.')

print()

