# 4. Usuário vai digitar 3  números, para criar um triângulo, verifique se um triângulo é equilátero, isósceles ou escaleno
# Um triângulo é chamado de equilátero se todos os lados possuem a mesma medida. 
# Um triângulo é chamado de isósceles se dois lados possuem a mesma medida. 
# Um triângulo é chamado de escaleno se todos os lados possuem medidas diferentes.

print('Vamos criar um triângulo!')
l1 = float(input('Quanto mede o primeiro lado do triângulo? '))
l2 = float(input('Quanto mede o segundo lado do triângulo? '))
l3 = float(input('Quanto mede o terceiro lado do triângulo? '))

if l1 == l2 == l3:
    print('Este triângulo é equilátero!')
elif l1 != l2 != l3:
    print('Este é um triângulo escaleno!')
else:
    print('Este triângulo é isóceles!')

print()

# --------------------------------------------------
# 5. Determine se um número é múltiplo de 5 e 7.

n3 = int(input('Digite um número: '))

if n3 % 5 == 0 and n3 % 7 == 0:
    print('Este número é múltiplo de 5 e de 7.')
elif n3 % 5 == 0 and n3 % 7 != 0:
    print('Este número é múltiplo de 5.')
elif n3 % 5 != 0 and n3 % 7 == 0:
    print('Este número é múltiplo de 7.')
else:
    print('Este número não é múltiplo de 5 nem de 7.')

print()

