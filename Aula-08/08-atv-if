# 7. Verifique se um número é divisível por 3 ou 5.

n5 = int(input('Digite um número: '))

if n5 % 3 == 0 and n5 % 5 != 0:
    print('Número divisível por 3.')
elif n5 % 5 == 0 and n5 % 3 != 0:
    print('Número divisível por 5.')
elif n5 % 3 == 0 and n5 % 5 == 0:
    print('Número divisível por 3 e por 5.')
else:
    print('Número não divisível por 3 nem por 5.')

