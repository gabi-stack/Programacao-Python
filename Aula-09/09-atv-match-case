# Exercício 2: Verificando se um número é positivo, negativo ou zero

n2 = int(input('Digite um número: '))

match n2:
    case n2 if n2 == 0:
        print('zero')
    case n2 if n2 > 0:
        print('positivo')
    case _:
        print('negativo')

