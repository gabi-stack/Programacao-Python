import customtkinter as ctk     # pip install customtkinter
import sqlite3

ctk.set_appearance_mode('Dark')
ctk.set_default_color_theme('blue')

conn =  sqlite3.connect('dados.db')
cursor = conn.cursor()

cursor.execute('CREATE TABLE IF NOT EXISTS itens(id INTEGER PRIMARY KEY AUTOINCREMENT, nome TEXT )')
conn.commit()

select_id = None


# FUNÇÕES

def atualizar_lista():
    for widget in scroll.winfo_children():
        widget.destroy()
    cursor.execute('SELECT * FROM itens ORDER BY id DESC')
    for item_id, nome in cursor.fetchall():
        btn = ctk.CTkButton(
            scroll,
            text=nome,
            anchor='w',
            fg_color=('grey', 'gray20'),
            text_color=('black', 'white'),
            hover_color=('grey', 'gray30'),
            command=lambda i = item_id , n = nome: selecionar(i, n)
        )
        btn.pack(fill='x', padx=2)

def selecionar(item_id, nome):
    global select_id
    select_id = item_id
    entry.delete(0, 'end')
    entry.insert(0, nome)
    btn_save.configure(text= 'Atualizar')

def limpar():
    global select_id
    select_id = None
    entry.delete(0, 'end')
    btn_save.configure(text= 'Salvar')


def salvar():
    txt = entry.get().strip()
    if not txt:
        return
    if select_id:
        cursor.execute(
            'UPDATE itens SET nome = ? WHERE id = ?', (select_id)
        )
    else:
        cursor.execute('INSERT INTO itens (nome) VALUES (?)', (txt,))
    conn.commit()
    limpar()
    atualizar_lista()

def excluir():
    if select_id:
        cursor.execute('DELETE FROM itens WHERE id= ?', (select_id,))
        conn.commit()
        limpar()
        atualizar_lista()





# interface 
app = ctk.CTk()
app.title('CRUD COM CUSTOM TKINTER')
app.geometry('500x600')


# INPUTS

entry = ctk.CTkEntry(app, placeholder_text='DIGITE O ITEM')
# cria o objeto 'filho' da classe CTK 
entry.pack(padx= 20, pady = (20,10), fill = 'x')
# Método que aplica o objeto na tela

# sessão do botão
btn_frame = ctk.CTkFrame(app, fg_color='transparent')
btn_frame.pack(padx = 20, fill = 'x')

# botão de salvar
btn_save = ctk.CTkButton(btn_frame, text = 'Salvar', hover_color='white', width=100, command=salvar)
btn_save.pack(side = 'left', expand = True, padx = 2)

# botão deletar
btn_delete = ctk.CTkButton(btn_frame, text='Deletar',
                           hover_color='white',
                           fg_color='red',
                           width=100,
                           command=excluir
                           )
btn_delete.pack(side = 'left', expand = True, padx = 2)

# botão limpar
btn_clear = ctk.CTkButton(btn_frame, text='Limpar',
                          hover_color='white',
                          fg_color='green',
                          width=100,
                          command=limpar
                          )
btn_clear.pack(side = 'left', expand = True, padx = 2)

# barra de rolagem
scroll = ctk.CTkScrollableFrame(app)
scroll.pack(padx=20, pady=20, fill='both', expand=True)



atualizar_lista()

app.mainloop()

