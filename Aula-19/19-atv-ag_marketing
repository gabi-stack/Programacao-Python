# AGÊNCIA DE MARKETING

import sqlite3
import customtkinter as ctk

c = sqlite3.connect('ag_marketing')
cs = c.cursor()

cs.execute('''
CREATE TABLE IF NOT EXISTS Clientes(
    id integer primary key autoincrement,
    Nome text not null,
    Idade integer not null,
    Email text not null, 
    Endereço text not null,
    Trabalho text not null,
    Graduação text not null
) 
'''
)

select_id = None

# FUNÇÕES

def atualizar_lista():
    for widget in scroll.winfo_children():
        widget.destroy()
    cs.execute('SELECT id, nome FROM Clientes ORDER BY id ASC')
    for cliente_id, nome in cs.fetchall():
        btn = ctk.CTkButton(
            scroll,
            text=nome,
            anchor='w',
            fg_color=('grey', 'gray20'),
            text_color=('black', 'white'),
            hover_color=('grey', 'gray30'),
            command=lambda i = cliente_id: selecionar(i)
        )
        btn.pack(fill='x', padx=2, pady=2)

def selecionar(cliente_id):
    global select_id
    select_id = cliente_id
    
    # Busca os dados completos do cliente selecionado
    cs.execute('SELECT Nome, Idade, Email, Endereço, Trabalho, Graduação FROM Clientes WHERE id = ?', (cliente_id,))
    cliente = cs.fetchone()
    
    if cliente:
        limpar_campos()
        entry_nome.insert(0, cliente[0])
        entry_idade.insert(0, str(cliente[1]))
        entry_email.insert(0, cliente[2])
        entry_endereco.insert(0, cliente[3])
        entry_trabalho.insert(0, cliente[4])
        entry_graduacao.insert(0, cliente[5])

def limpar_campos():
    entry_nome.delete(0, 'end')
    entry_idade.delete(0, 'end')
    entry_email.delete(0, 'end')
    entry_endereco.delete(0, 'end')
    entry_trabalho.delete(0, 'end')
    entry_graduacao.delete(0, 'end')

def limpar():
    global select_id
    select_id = None
    limpar_campos()
    btn_save.configure(text='Salvar')


def salvar():
    nome = entry_nome.get().strip()
    idade = entry_idade.get().strip()
    email = entry_email.get().strip()
    endereco = entry_endereco.get().strip()
    trabalho = entry_trabalho.get().strip()
    graduacao = entry_graduacao.get().strip()
    
    # Validação simples para evitar campos vazios
    if not (nome and idade and email and endereco and trabalho and graduacao):
        return

    if select_id:
        # Atualiza cliente existente
        cs.execute('''
            UPDATE Clientes 
            SET Nome = ?, Idade = ?, Email = ?, Endereço = ?, Trabalho = ?, Graduação = ?
            WHERE id = ?
        ''', (nome, idade, email, endereco, trabalho, graduacao, select_id))
    else:
        # Insere novo cliente
        cs.execute('''
            INSERT INTO Clientes (Nome, Idade, Email, Endereço, Trabalho, Graduação)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (nome, idade, email, endereco, trabalho, graduacao))

    c.commit()
    limpar()
    atualizar_lista()

def excluir():
    global select_id
    if select_id:
        cs.execute('DELETE FROM Clientes WHERE id = ?', (select_id,))
        c.commit()
        limpar()
        atualizar_lista()



# INTERFACE

app = ctk.CTk()
app.title('LEADS MARKETING')
app.geometry('600x650')

entry_nome = ctk.CTkEntry(app, placeholder_text='NOME', width=300)
entry_nome.pack(pady=5)

entry_idade = ctk.CTkEntry(app, placeholder_text='IDADE', width=300)
entry_idade.pack(pady=5)

entry_email = ctk.CTkEntry(app, placeholder_text='E-MAIL', width=300)
entry_email.pack(pady=5)

entry_endereco = ctk.CTkEntry(app, placeholder_text='ENDEREÇO', width=300)
entry_endereco.pack(pady=5)

entry_trabalho = ctk.CTkEntry(app, placeholder_text='TRABALHO', width=300)
entry_trabalho.pack(pady=5)

entry_graduacao = ctk.CTkEntry(app, placeholder_text='GRADUAÇÃO', width=300)
entry_graduacao.pack(pady=5)

# Container de botões
btn_frame = ctk.CTkFrame(app, fg_color='transparent')
btn_frame.pack(pady=10)

# botão de salvar
btn_save = ctk.CTkButton(btn_frame, text = 'Salvar', width=100, command=salvar)
btn_save.pack(side = 'left', expand = True, padx = 5)

# botão deletar
btn_delete = ctk.CTkButton(btn_frame, text='Deletar',
                           hover_color='darkred',
                           fg_color='red',
                           width=100,
                           command=excluir
                           )
btn_delete.pack(side = 'left', expand = True, padx = 5)

# botão limpar
btn_clear = ctk.CTkButton(btn_frame, text='Limpar',
                          hover_color='darkgreen',
                          fg_color='green',
                          width=100,
                          command=limpar
                          )
btn_clear.pack(side = 'left', expand = True, padx = 5)

# barra de rolagem
scroll = ctk.CTkScrollableFrame(app, width=350, height=200)
scroll.pack(padx=20, pady=20, fill='both', expand=True)


atualizar_lista()

app.mainloop()
