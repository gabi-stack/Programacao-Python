# DESAFIO 2 - > SISTEMA COM MÓDULOS 

import statistics

def mostrar_estatistica(nome_empresa, salario):
    media = statistics.mean(salario)
    moda = statistics.mode(salario)
    desvio = statistics.stdev(salario)
    mediana = statistics.median(salario)

    print(nome_empresa)
    print('Media =', media)
    print('Moda =', moda)
    print('Mediana =', mediana)
    print('Desvio =', round(desvio))

