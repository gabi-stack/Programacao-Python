import statistics

def estatistica(lista_notas):
    moda  =  round(statistics.mode(lista_notas),2)
    media = round(statistics.mean(lista_notas),2)
    desvio =  round(statistics.stdev(lista_notas),2)
    mediana =  round(statistics.median(lista_notas),2)
    variancia =  round(statistics.variance(lista_notas),2)
    menor =  round(min(lista_notas),2)
    maior =  round(max(lista_notas),2)

    c = set(lista_notas)
    # Verifica se existe moda (repetição) na lista
    if len(lista_notas) == len(c):

        return f'''
                MODA = N/A
                MÉDIA = {media}
                DESVIO PADRÃO = {desvio}
                MEDIANA = {mediana} 
                VARIÂNCIA = {variancia}
                MENOR NOTA = {menor}
                MAIOR NOTA = {maior}
        '''
    else:
        return f'''
                MODA = {moda}
                MÉDIA = {media}
                DESVIO PADRÃO = {desvio}
                MEDIANA = {mediana} 
                VARIÂNCIA = {variancia}
                MENOR NOTA = {menor}
                MAIOR NOTA = {maior}
        '''
