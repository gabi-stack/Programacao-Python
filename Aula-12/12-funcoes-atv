# 1 CRIE UMA FUNÇÃO PARA COMPARAR 2 NÚMEROS (par ou impar). UTILIZE VARIÁVEIS LOCAIS.

def comparar(n1,n2):

    print(f'Comparando {n1} e {n2}:')

    if n1 % 2==0 and n2 % 2 == 1:
        print(f'{n1} é par')
    elif  n1 % 2 == 1 and n2 % 2 == 0:
        print(f'{n2} é par')   
    elif n1  % 2 ==0 and n2 % 2 == 0:
        print('Ambos são pares')
    else:
        print('Nenhum é par')       

comparar(5,22)    
print()

