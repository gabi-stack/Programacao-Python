# 5 - Peça ao usuário que insira um número inteiro positivo e, em seguida, calcule a soma de todos os números pares de 2 até o número inserido.
def ex_5():
    n = int(input('Número: '))
    if n%2 != 0:
        n += 1
    else:
        n += 2
    lista = list(range(2,n,2))
    print(lista)
    soma = sum(lista)
    print(soma)

